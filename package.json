{
  "name": "impextech",
  "version": "0.1.0",
  "private": true,
  "description": "Canada-sourced, verified, and guaranteed. Nigerian ecommerce for authentic used gadgets.",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @impextech/api dev",
    "dev:web": "pnpm --filter @impextech/web dev",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @impextech/api build",
    "build:web": "pnpm --filter @impextech/web build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "bcrypt",
      "better-sqlite3",
      "sharp"
    ]
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  }
}
